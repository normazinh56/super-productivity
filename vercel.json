{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "angular"
    },
    "wayland-idle-helper": {
      "root": "electron/wayland-idle-helper",
      "runtime": "rust"
    },
    "ai-productivity-prompts": {
      "root": "packages/plugin-dev/ai-productivity-prompts",
      "framework": "vite"
    },
    "automations": {
      "root": "packages/plugin-dev/automations",
      "framework": "vite"
    },
    "boilerplate-solid-js": {
      "root": "packages/plugin-dev/boilerplate-solid-js",
      "framework": "vite"
    },
    "procrastination-buster": {
      "root": "packages/plugin-dev/procrastination-buster",
      "framework": "vite"
    },
    "super-sync-server": {
      "root": "packages/super-sync-server",
      "framework": "fastify"
    },
    "vite-plugin": {
      "root": "packages/vite-plugin",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
